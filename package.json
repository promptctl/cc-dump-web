{
  "name": "cc-dump",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently --names proxy,server,ui --prefix-colors blue,magenta,green \"pnpm --silent --filter @cc-dump/proxy start\" \"pnpm --silent --filter @cc-dump/server dev\" \"pnpm --silent --filter @cc-dump/ui dev\"",
    "typecheck": "tsc && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
